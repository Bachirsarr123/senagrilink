# ===========================
# Backend Laravel
# ===========================
backend/vendor/
backend/.env
backend/.env.backup
backend/storage/logs/*.log
# storage/framework/{cache,sessions,views} et bootstrap/cache sont versionnés vides
# (fichier .gitignore interne) : Laravel exige qu'ils existent dès le clone.
backend/.phpunit.result.cache
backend/coverage.xml
backend/test-report.xml

